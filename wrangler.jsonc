{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careatlas",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash"
  }
}
