{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careatlas.org/schemas/tract-evidence.v1.schema.json",
  "title": "CareAtlas census-tract evidence observation",
  "description": "A single source-backed or explicitly missing measure for one Census tract. This schema does not define an access-gap score or classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "geography",
    "measure",
    "source",
    "value",
    "unit",
    "estimateType",
    "missingness",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geoid", "stateFips", "countyFips", "tractCode"],
      "properties": {
        "type": { "const": "census_tract" },
        "geoid": { "type": "string", "pattern": "^[0-9]{11}$" },
        "stateFips": { "type": "string", "pattern": "^[0-9]{2}$" },
        "countyFips": { "type": "string", "pattern": "^[0-9]{3}$" },
        "tractCode": { "type": "string", "pattern": "^[0-9]{6}$" }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "evidenceLayer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "evidenceLayer": {
          "enum": [
            "documented_capacity",
            "community_health_need",
            "social_barriers",
            "official_shortage"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agency", "dataset", "releaseYear", "url"],
      "properties": {
        "agency": { "type": "string", "minLength": 1 },
        "dataset": { "type": "string", "minLength": 1 },
        "releaseYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "value": { "type": ["number", "string", "boolean", "null"] },
    "unit": { "type": "string", "minLength": 1 },
    "estimateType": {
      "enum": ["observed", "modeled", "derived", "designation", "unavailable"]
    },
    "missingness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isMissing", "reason"],
      "properties": {
        "isMissing": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRecordId", "transformation", "checkedDate"],
      "properties": {
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "transformation": { "type": "string", "minLength": 1 },
        "checkedDate": { "type": "string", "format": "date" }
      }
    }
  }
}
